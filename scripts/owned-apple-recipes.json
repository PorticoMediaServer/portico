  "apps/native/test/apple-audio-capture-tests.m": {
    "runnable": true,
    "sdk": "iphonesimulator",
    "sources": [
      "apps/native/Native/PorticoAudioCapture.m"
    ],
    "frameworks": [
      "Foundation",
      "AVFoundation"
    ],
    "runs": [
      {
        "args": [
          "44100",
          "2"
        ],
        "env": {
          "PORTICO_AUDIO_OUTPUT_CAPTURE": "{tmp}/capture-44100.caf"
        }
      },
      {
        "args": [
          "96000",
          "8"
        ],
        "env": {
          "PORTICO_AUDIO_OUTPUT_CAPTURE": "{tmp}/capture-96000.caf"
        }
      }
    ],
    "verdict": {
      "kind": "fields",
      "true": [
        "pass",
        "sourceFloat32Exact"
      ],
      "false": [
        "droppedOrFailed"
      ],
      "cases": 1
    }
  },
