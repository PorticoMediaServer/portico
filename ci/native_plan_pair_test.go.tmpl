package PACKAGE

// Diagnostic-only Go overlay. Never compiled into a production binary.
import (
	"compress/gzip"
	"context"
	"database/sql"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"sync/atomic"
	"testing"

	"github.com/PorticoMediaServer/portico/server/internal/store/internal/sqliteconn"
	"github.com/PorticoMediaServer/portico/server/internal/store/stmt"
	"github.com/PorticoMediaServer/portico/server/internal/store/stmt/plan"
)

var nativePairSequence atomic.Uint64

func nativePairWrite(t *testing.T, label string, value any) {
	t.Helper()
	dir := os.Getenv("PORTICO_NATIVE_PLAN_OUTPUT")
	if dir == "" {
		t.Fatal("native diagnostic overlay requires an output directory")
	}
	if err := os.MkdirAll(dir, 0700); err != nil {
		t.Fatal(err)
	}
	name := fmt.Sprintf("%03d-%s-%s.json.gz", nativePairSequence.Add(1), strings.ReplaceAll(t.Name(), "/", "__"), label)
	f, err := os.Create(filepath.Join(dir, name))
	if err != nil {
		t.Fatal(err)
	}
	z := gzip.NewWriter(f)
	encodeErr := json.NewEncoder(z).Encode(value)
	zipErr, closeErr := z.Close(), f.Close()
	if encodeErr != nil || zipErr != nil || closeErr != nil {
		t.Fatalf("diagnostic output: encode=%v gzip=%v close=%v", encodeErr, zipErr, closeErr)
	}
}

func nativePairRows(ctx context.Context, conn *sql.Conn, query string, args ...any) (plan.Rows, string) {
	rows, err := conn.QueryContext(ctx, query, args...)
	if err != nil {
		return plan.Rows{}, err.Error()
	}
	defer rows.Close()
	columns, err := rows.Columns()
	if err != nil {
		return plan.Rows{}, err.Error()
	}
	result := plan.Rows{Columns: columns, Values: [][]any{}}
	for rows.Next() {
		values := make([]any, len(columns))
		dest := make([]any, len(columns))
		for i := range values {
			dest[i] = &values[i]
		}
		if err := rows.Scan(dest...); err != nil {
			return result, err.Error()
		}
		for i, value := range values {
			if b, ok := value.([]byte); ok {
				values[i] = append([]byte(nil), b...)
			}
		}
		result.Values = append(result.Values, values)
	}
	if err := rows.Err(); err != nil {
		return result, err.Error()
	}
	return result, ""
}

func nativePairCapture(t *testing.T, ctx context.Context, conn *sql.Conn, registry *stmt.Registry, fixture plan.Fixture, policy plan.IndexPolicy) (plan.Golden, error) {
	t.Helper()
	g, captureErr := plan.Capture(ctx, conn, registry, fixture, policy)
	type rawPlan struct {
		ID, Cohort        string
		VM, EQP           plan.Rows
		VMError, EQPError string
	}
	packet := struct {
		Golden            plan.Golden
		CaptureError      string
		NativeEnvironment map[string]plan.Rows
		EnvironmentErrors map[string]string
		RawPlans          []rawPlan
	}{Golden: g, NativeEnvironment: map[string]plan.Rows{}, EnvironmentErrors: map[string]string{}, RawPlans: []rawPlan{}}
	if captureErr != nil {
		packet.CaptureError = captureErr.Error()
	}
	for name, query := range map[string]string{
		"engine":         "SELECT sqlite_version(),sqlite_source_id()",
		"compileOptions": "PRAGMA compile_options",
		"functions":      "PRAGMA function_list",
		"collations":     "PRAGMA collation_list",
		"databases":      "PRAGMA database_list",
	} {
		packet.NativeEnvironment[name], packet.EnvironmentErrors[name] = nativePairRows(ctx, conn, query)
	}
	// EXPLAIN only: retain every declared cohort even if Capture refuses one.
	// This neither executes the statement nor mints/reconstructs a receipt.
	for _, entry := range registry.Manifest() {
		for _, cohort := range entry.Cohorts {
			r := rawPlan{ID: string(entry.ID), Cohort: cohort.Name}
			r.VM, r.VMError = nativePairRows(ctx, conn, "EXPLAIN "+entry.SQL, cohort.Bindings...)
			r.EQP, r.EQPError = nativePairRows(ctx, conn, "EXPLAIN QUERY PLAN "+entry.SQL, cohort.Bindings...)
			packet.RawPlans = append(packet.RawPlans, r)
		}
	}
	nativePairWrite(t, "capture", packet)
	// Every existing assertion still receives the real result/error unchanged.
	return g, captureErr
}

func nativePairForeignKeys(t *testing.T, ctx context.Context, conn *sql.Conn, policy sqliteconn.Config) (plan.ForeignKeyAudit, error) {
	t.Helper()
	audit, err := plan.ForeignKeys(ctx, conn, policy)
	message := ""
	if err != nil {
		message = err.Error()
	}
	nativePairWrite(t, "foreign-keys", struct {
		Audit plan.ForeignKeyAudit
		Error string
	}{audit, message})
	return audit, err
}
