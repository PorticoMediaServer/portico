{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@core/*": [
        "../packages/client-core/src/*"
      ],
      "@design": [
        "../packages/design/src/index.ts"
      ],
      "@i18n": [
        "../packages/i18n/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "@core": [
        "../packages/client-core/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
