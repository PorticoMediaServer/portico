{
  "schema": "GetCapabilitiesResponse",
  "method": "GET",
  "path": "/v1/capabilities",
  "auth": "viewer",
  "status": 200,
  "response": {
    "api": {
      "major": 1,
      "level": 1
    },
    "features": {
      "downloads": "unavailable",
      "dvr": "unavailable",
      "feedback": "enabled",
      "live_tv": "unavailable",
      "playback_v1": "enabled",
      "playback_v1_kinds": "movie,episode,video,audiobook,audiobook_file,book,song,track",
      "queueTransitions": "enabled",
      "subtitle_burn_in": "enabled",
      "transcoding": "enabled",
      "watch_together": "enabled"
    },
    "limits": {
      "bulkJobsActiveMax": 32,
      "downloadBatchMax": 100,
      "longPollMaxMs": 25000,
      "pageSizeMax": 100,
      "playlistWriteMax": 200,
      "queueKeysMax": 10000000,
      "selectorIdsMax": 500
    }
  }
}
