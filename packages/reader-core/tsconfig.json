{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "strict": true, "erasableSyntaxOnly": true,
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "types": []
  },
  "include": ["src/**/*.ts"]
}
