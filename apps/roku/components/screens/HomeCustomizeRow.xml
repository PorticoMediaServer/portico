<?xml version="1.0" encoding="utf-8"?>
<!-- One of Home's rows in Customize Home (collections frame 28): the grip, the row's name (with
     its note under it), and on the right its switch, or a lock with "Always on Home" for a row the
     server keeps. A saved view has its filter tile before the name. Held, the row floats on the
     bright plate with the focus ring; the place it was picked up from shows as an empty slot. -->
<component name="HomeCustomizeRow" extends="Group">
  <interface>
    <!-- {title, note, right, view, hidden}: right is "switch", "lock" (a row the server keeps) or ""
         (a saved view being added); view puts the filter tile before the name. -->
    <field id="model" type="assocarray" onChange="layout"/>
    <field id="rowWidth" type="float"/>
    <!-- "" at rest, "focus" (the row has focus), "switch" (its switch has focus), "held" or "slot" -->
    <field id="look" type="string" onChange="paint"/>
  </interface>
  <script type="text/brightscript" uri="HomeCustomizeRow.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <children>
    <Poster id="ring" uri="pkg:/images/focus-14.9.png" visible="false"/>
    <Poster id="plate" uri="pkg:/images/round-14.9.png" visible="false"/>
    <Poster id="slot" uri="pkg:/images/line-14.9.png" visible="false"/>
    <Group id="parts">
      <Poster id="grip" uri="pkg:/images/i-grip-26.png" width="26" height="26"/>
      <Poster id="tile" uri="pkg:/images/round-10.9.png" width="34" height="34"/>
      <Poster id="tileIcon" uri="pkg:/images/i-sliders-28.png" width="20" height="20"/>
      <Label id="name"/>
      <Label id="note"/>
      <Poster id="lock" uri="pkg:/images/i-lock-28.png" width="18" height="18"/>
      <Label id="always" text="Always on Home"/>
      <Poster id="switch" width="64" height="36"/>
      <Poster id="switchRing" uri="pkg:/images/focus-20.9.png" visible="false"/>
    </Group>
  </children>
</component>
