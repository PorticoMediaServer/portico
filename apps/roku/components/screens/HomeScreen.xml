<?xml version="1.0" encoding="utf-8"?>
<!-- Home, on the Browse frame with the moderate hero (rule 14): the hero describes the card in
     focus on every row, and the row in focus holds the slot under it, its heading at
     frames().browse.rowsY. The first row shows whole and about half the next one shows below. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <!-- Path of the art for the backdrop ("" for none). The scene shows it. -->
    <field id="art" type="string"/>
    <!-- Set true to go to the top of the page (the opening state). -->
    <field id="toTop" type="boolean" alwaysNotify="true" onChange="onToTop"/>
    <!-- Asks the scene to open or play a title: {item, play}. -->
    <field id="open" type="assocarray" alwaysNotify="true"/>
    <!-- Asks the scene for the side sheet; the choice comes back in menuChosen. -->
    <field id="menu" type="assocarray" alwaysNotify="true"/>
    <!-- Set by the scene when another page is opened over Home. -->
    <field id="covered" type="boolean" onChange="onCovered"/>
    <field id="menuChosen" type="string" alwaysNotify="true" onChange="onMenuChosen"/>
    <!-- A library's id, for its Discover tab: the same rows read from the library's own landing. -->
    <field id="library" type="string" onChange="load"/>
  </interface>
  <script type="text/brightscript" uri="HomeScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <children>
    <Hero id="hero" mode="preview" visible="false"/>
    <!-- Rows above the one in focus slide up out of this window, under the hero's words. -->
    <Group id="window">
      <Group id="page"/>
    </Group>
    <PageState id="notice" visible="false"/>
    <!-- The hero's description is read once focus rests on a card (a row's titles carry no synopsis). -->
    <Timer id="rest" duration="0.35"/>
    <!-- Nothing shows for the first 300 ms of loading; then outlines of the real sizes (rule 9). -->
    <Timer id="loadingDelay" duration="0.3"/>
    <Group id="loadingRow" visible="false"/>
    <Animation id="slide" duration="0.28" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="slideTo" key="[0.0, 1.0]" fieldToInterp="page.translation"/>
    </Animation>
  </children>
</component>
