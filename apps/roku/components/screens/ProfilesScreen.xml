<?xml version="1.0" encoding="utf-8"?>
<!-- Who's watching: one row of faces, then the PIN pad for a profile that has a PIN
     (auth.html frames 16 and 17), and from its Forgot PIN? the hand-off to a phone or computer.
     Every part is placed from frames().signIn in init(). -->
<component name="ProfilesScreen" extends="Group">
  <interface>
    <field id="serverName" type="string"/>
    <!-- The account's profiles as the server lists them. -->
    <field id="profiles" type="array" onChange="onProfiles"/>
    <!-- The profile used last, to start on. -->
    <field id="last" type="string"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <!-- Set when a profile is chosen: {session, profile}. -->
    <field id="chosen" type="assocarray"/>
    <function name="chooseOnly"/>
  </interface>
  <script type="text/brightscript" uri="ProfilesScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Address.brs"/>
  <children>
    <Poster id="mark" uri="pkg:/images/wordmark.png" width="176" height="40"/>
    <Group id="faces">
      <!-- bottom-aligned, so a long server name wraps upward and the faces never move -->
      <Label id="title" height="200" horizAlign="center" vertAlign="bottom" wrap="true" maxLines="2"/>
      <Group id="row"/>
      <Label id="note" width="1920" horizAlign="center"/>
    </Group>
    <Group id="pin" visible="false">
      <Poster id="pinFace" uri="pkg:/images/disc.png" width="196" height="196"/>
      <Poster id="pinShade" uri="pkg:/images/face-shade.png" width="196" height="196"/>
      <Label id="pinInitial" width="196" height="196" horizAlign="center" vertAlign="center"/>
      <Label id="pinTitle" text="Enter profile PIN" horizAlign="center"/>
      <Label id="pinName" horizAlign="center"/>
      <PinPad id="pad" digits="4" extra="Forgot PIN?"/>
      <Label id="pinNote" horizAlign="center" wrap="true" maxLines="3"/>
      <KeyHints id="hints" small="true" horizAlignment="center"/>
    </Group>
    <!-- Forgot PIN?: a new PIN is set on a phone or computer, as on the other TV apps -->
    <Group id="forgot" visible="false">
      <Label id="forgotName"/>
      <Label id="forgotTitle" text="Forgot PIN?"/>
      <Label id="forgotBody" width="820" wrap="true" maxLines="4"/>
      <ButtonRow id="forgotButtons"/>
      <QrCard id="forgotCard" note="Scan the code with your phone, or go to this address on a computer."/>
    </Group>
  </children>
</component>
