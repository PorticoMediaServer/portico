<?xml version="1.0" encoding="utf-8"?>
<!-- The video player: one playback session with the server, Roku's Video node under our own controls. -->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="item" type="assocarray"/>
    <!-- True to start from the beginning instead of where the title was left. -->
    <field id="startOver" type="boolean"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="art" type="string"/>
    <!-- Set true when the player is done and the page under it should come back. -->
    <field id="closed" type="boolean" alwaysNotify="true"/>
    <!-- The side sheet for Subtitles, Audio and Quality: asked of the scene, answered in menuChosen. -->
    <field id="menu" type="assocarray" alwaysNotify="true"/>
    <field id="menuChosen" type="string" alwaysNotify="true" onChange="onMenuChosen"/>
  </interface>
  <script type="text/brightscript" uri="PlayerScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Queue.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF"/>
    <Video id="video" width="1920" height="1080" enableUI="false"/>
    <!-- The overlay (tv-player frame 1): a top row, the seek bar, the time row and the button row.
         PlayerScreen.brs places every part from frames().player; none carries an edge of its own here. -->
    <Group id="controls" visible="false">
      <Poster uri="pkg:/images/fade-up.png" width="1920" height="300" opacity="0.75"/>
      <Poster uri="pkg:/images/fade-down.png" width="1920" height="600" translation="[0,480]" opacity="0.96"/>
      <Label id="title"/>
      <Label id="code"/>
      <Label id="sub"/>
      <Label id="clock" width="500" horizAlign="right"/>
      <Label id="ends" width="500" horizAlign="right"/>
      <Rectangle id="track" height="8"/>
      <Rectangle id="ahead" height="8" visible="false"/>
      <Rectangle id="played" height="8"/>
      <Rectangle id="was" width="4" height="26" visible="false"/>
      <Poster id="knobRing" uri="pkg:/images/focus-disc.png" width="60" height="60" visible="false"/>
      <Poster id="knob" uri="pkg:/images/disc.png" width="22" height="22"/>
      <Label id="at"/>
      <Label id="left" width="500" horizAlign="right"/>
      <Group id="buttons"/>
      <Poster id="ring" uri="pkg:/images/focus-disc.png"/>
      <Poster id="pillRing" uri="pkg:/images/focus-14.9.png" visible="false"/>
      <!-- An icon-only button names itself while it has focus, in the empty middle of the time row. -->
      <Group id="flab">
        <Poster id="flabPlate" uri="pkg:/images/round-10.9.png" height="40"/>
        <Label id="flabText" height="40" vertAlign="center"/>
      </Group>
      <!-- While a scrub waits for OK, these key hints stand in the button row's place. -->
      <Group id="hints" visible="false"/>
    </Group>
    <!-- Skip intro, Skip credits: at the lower right, above where the overlay goes, so it never
         moves when the overlay comes up. It takes focus only while the overlay is down. -->
    <ButtonRow id="prompt" visible="false"/>
    <!-- After an automatic skip (tv-player frame 3, below): what was skipped, for six seconds, and Undo. -->
    <Group id="undo" visible="false">
      <Poster id="undoPlate" uri="pkg:/images/round-20.9.png" height="104"/>
      <Poster id="undoTick" uri="pkg:/images/i-check-28.png" translation="[30,26]" width="28" height="28"/>
      <Label id="undoText" translation="[70,18]" height="36" vertAlign="center"/>
      <Rectangle id="undoTrack" translation="[30,70]" height="4"/>
      <Rectangle id="undoLeft" translation="[30,70]" height="4"/>
      <ButtonRow id="undoRow"/>
      <Animation id="undoRun" duration="6" easeFunction="linear">
        <FloatFieldInterpolator id="undoShrink" key="[0.0, 1.0]" keyValue="[200.0, 0.0]" fieldToInterp="undoLeft.width"/>
      </Animation>
    </Group>
    <!-- Up next during the credits (tv-player frame 5): the next title, Play now focused, Watch
         credits beside it puts the card away. In the same place as the skip prompt. -->
    <Group id="upNext" visible="false">
      <Poster id="unPlate" uri="pkg:/images/round-20.9.png" width="680" height="296"/>
      <Rectangle id="unBack" translation="[26,26]" width="256" height="144"/>
      <Poster id="unStill" translation="[26,26]" width="256" height="144"/>
      <Label id="unLabel" translation="[306,30]" text="Up next"/>
      <Label id="unTitle" translation="[306,60]" width="350" wrap="true" maxLines="3"/>
      <Label id="unSub" translation="[306,104]" width="350"/>
      <Label id="unWhen" translation="[306,140]" width="350" wrap="true" maxLines="2"/>
      <ButtonRow id="unRow" translation="[26,200]"/>
    </Group>
    <!-- The end of a film with nothing queued (tv-player frame 7): its art comes back behind Finished. -->
    <Group id="finished" visible="false">
      <Rectangle id="finBack" width="1920" height="1080"/>
      <Poster id="finArt" width="1920" height="1080" opacity="0.55"/>
      <Poster uri="pkg:/images/fade-down.png" width="1920" height="540" translation="[0,540]"/>
      <Label id="finLabel" text="Finished"/>
      <Label id="finTitle" width="1100" wrap="true" maxLines="2"/>
      <Label id="finMeta" width="1100"/>
      <ButtonRow id="finRow"/>
    </Group>
    <!-- While a stream is being made ready or is catching up: the screen is never plain black. -->
    <Group id="wait" visible="false">
      <Poster id="spinner" uri="pkg:/images/i-spinner-64.png" width="64" height="64"/>
      <Label id="waitTitle" width="1400" horizAlign="center"/>
      <Label id="waitText" width="1400" horizAlign="center"/>
      <Animation id="spin" duration="0.9" repeat="true" easeFunction="linear">
        <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="spinner.rotation"/>
      </Animation>
    </Group>
    <PageState id="notice" visible="false"/>
    <Timer id="hide" duration="5"/>
    <Timer id="report" duration="10" repeat="true"/>
    <Timer id="tick" duration="1" repeat="true"/>
    <Timer id="settle" duration="0.6"/>
    <Timer id="again" duration="1"/>
    <Timer id="retry" duration="3"/>
    <!-- Counts down the wait before the next episode, once a second. -->
    <Timer id="count" duration="1" repeat="true"/>
  </children>
</component>
