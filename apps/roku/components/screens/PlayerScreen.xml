<?xml version="1.0" encoding="utf-8"?>
<!-- The video player: one playback session with the server, Roku's Video node under our own controls. -->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="item" type="assocarray"/>
    <!-- True to start from the beginning instead of where the title was left. -->
    <field id="startOver" type="boolean"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="art" type="string"/>
    <!-- Set true when the player is done and the page under it should come back. -->
    <field id="closed" type="boolean" alwaysNotify="true"/>
    <!-- The side sheet for Subtitles, Audio and Quality: asked of the scene, answered in menuChosen. -->
    <field id="menu" type="assocarray" alwaysNotify="true"/>
    <field id="menuChosen" type="string" alwaysNotify="true" onChange="onMenuChosen"/>
  </interface>
  <script type="text/brightscript" uri="PlayerScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF"/>
    <Video id="video" width="1920" height="1080" enableUI="false"/>
    <!-- The overlay (tv-player frame 1): the top row from the 80 px line, the seek bar, time row and
         button row ending on the 80 px line at the foot. Every part is placed from those two edges. -->
    <Group id="controls" visible="false">
      <Poster uri="pkg:/images/fade-up.png" width="1920" height="300" opacity="0.75"/>
      <Poster uri="pkg:/images/fade-down.png" width="1920" height="600" translation="[0,480]" opacity="0.96"/>
      <Label id="title" translation="[96,80]" width="1300"/>
      <Label id="code" translation="[96,134]"/>
      <Label id="sub" translation="[96,134]"/>
      <Label id="clock" translation="[1324,80]" width="500" horizAlign="right"/>
      <Label id="ends" translation="[1324,124]" width="500" horizAlign="right"/>
      <Rectangle id="track" translation="[96,828]" width="1728" height="8" color="0xEDF5FA38"/>
      <Rectangle id="ahead" translation="[96,828]" height="8" color="0x5CB3E26B" visible="false"/>
      <Rectangle id="played" translation="[96,828]" height="8" color="0x5CB3E2FF"/>
      <Rectangle id="was" width="4" height="26" color="0xEDF5FAE6" visible="false"/>
      <Poster id="knobRing" uri="pkg:/images/focus-disc.png" width="60" height="60" visible="false"/>
      <Poster id="knob" uri="pkg:/images/disc.png" width="22" height="22"/>
      <Label id="at" translation="[96,862]"/>
      <Label id="left" translation="[1324,862]" width="500" horizAlign="right"/>
      <Group id="buttons" translation="[0,912]"/>
      <Poster id="ring" uri="pkg:/images/focus-disc.png"/>
      <Poster id="pillRing" uri="pkg:/images/focus-14.9.png" visible="false"/>
      <!-- An icon-only button names itself while it has focus, in the empty middle of the time row. -->
      <Group id="flab">
        <Poster id="flabPlate" uri="pkg:/images/round-10.9.png" blendColor="0x071018E6" height="40"/>
        <Label id="flabText" height="40" vertAlign="center"/>
      </Group>
      <!-- While a scrub waits for OK, these key hints stand in the button row's place. -->
      <Group id="hints" translation="[96,938]" visible="false"/>
    </Group>
    <!-- While a stream is being made ready or is catching up: the screen is never plain black. -->
    <Group id="wait" visible="false">
      <Poster id="spinner" uri="pkg:/images/i-spinner-64.png" width="64" height="64" translation="[928,470]" blendColor="0xD5EFFFFF"/>
      <Label id="waitTitle" translation="[260,566]" width="1400" horizAlign="center"/>
      <Label id="waitText" translation="[260,612]" width="1400" horizAlign="center"/>
      <Animation id="spin" duration="0.9" repeat="true" easeFunction="linear">
        <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="spinner.rotation"/>
      </Animation>
    </Group>
    <Notice id="notice" visible="false"/>
    <Timer id="hide" duration="5"/>
    <Timer id="report" duration="10" repeat="true"/>
    <Timer id="tick" duration="1" repeat="true"/>
    <Timer id="settle" duration="0.6"/>
    <Timer id="again" duration="1"/>
    <Timer id="retry" duration="3"/>
  </children>
</component>
