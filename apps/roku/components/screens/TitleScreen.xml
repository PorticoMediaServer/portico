<?xml version="1.0" encoding="utf-8"?>
<!-- A film's page: what it is and its buttons, then More like this, then Details with the cast. -->
<component name="TitleScreen" extends="Group">
  <interface>
    <!-- The title to show, as a row or list gave it; the page reads the rest. -->
    <field id="item" type="assocarray" onChange="onItem"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="art" type="string"/>
    <!-- Asks the scene to open or play a title: {item, play, startOver}. -->
    <field id="open" type="assocarray" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="TitleScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <children>
    <Group id="top">
      <Hero id="hero" mode="title"/>
      <Label id="credits" translation="[200,428]" width="1300"/>
      <ButtonRow id="buttons" translation="[200,484]"/>
    </Group>
    <Label id="smallTitle" translation="[197,58]" width="1500" visible="false"/>
    <TitleSections id="sections" translation="[0,700]"/>
  </children>
</component>
