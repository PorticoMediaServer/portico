<?xml version="1.0" encoding="utf-8"?>
<!-- A film's page, on the Title page frame with the moderate hero (rule 14): the hero's words and
     action row from frames().title.copyTop, the section strip fixed at tabsY and the first row at
     rowY, so one full row of posters shows. Then More like this, then Details with the cast. -->
<component name="TitleScreen" extends="Group">
  <interface>
    <!-- The title to show, as a row or list gave it; the page reads the rest. -->
    <field id="item" type="assocarray" onChange="onItem"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="art" type="string"/>
    <!-- True while the page's rows and words lie over the art: the scene dims it. -->
    <field id="quiet" type="boolean"/>
    <!-- Asks the scene to open or play a title: {item, play, startOver}. -->
    <field id="open" type="assocarray" alwaysNotify="true"/>
    <!-- Asks the scene for the side sheet (the "..." button, or *); the choice comes back in menuChosen. -->
    <field id="menu" type="assocarray" alwaysNotify="true"/>
    <field id="menuChosen" type="string" alwaysNotify="true" onChange="onMenuChosen"/>
  </interface>
  <script type="text/brightscript" uri="TitleScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/CardMenu.brs"/>
  <children>
    <!-- Holds focus while the section strip has it; its keys come up to the page (onKeyEvent). The
         page itself cannot take focus back from the row inside it. -->
    <Group id="stripStop" focusable="true"/>
    <Hero id="hero" mode="title"/>
    <TitleSections id="sections"/>
    <FileInfo id="fileInfo"/>
  </children>
</component>
