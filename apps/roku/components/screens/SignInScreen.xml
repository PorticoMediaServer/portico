<?xml version="1.0" encoding="utf-8"?>
<!-- Signing in on a television: the front door, then a Portico Account (AccountPages), or a local
     server's address and a code approved on a phone or computer (with a QR code), or a password
     typed with Roku's keyboard (connect.html frame 40, auth.html frame 9). Every part is placed from frames().signIn in init(). -->
<component name="SignInScreen" extends="Group">
  <interface>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <!-- Set when a sign-in succeeds: {origin, serverName, session, profiles}. -->
    <field id="signedIn" type="assocarray"/>
    <!-- Why the front door is showing, when it is not the first run ("You were signed out of ..."). -->
    <field id="notice" type="string" onChange="onNotice"/>
    <!-- The address of the server last used, offered again in the address box. -->
    <field id="address" type="string" onChange="onNotice"/>
    <!-- From Switch server: straight to a local server's address, or to one of the Portico Account's servers by its id. -->
    <function name="askAddress"/>
    <function name="openAccount"/>
  </interface>
  <script type="text/brightscript" uri="SignInScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Store.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Servers.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Address.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Dialog.brs"/>
  <children>
    <!-- Holds focus for a found server's row: the page cannot take focus back from its own Type an address button. -->
    <Group id="nearbyStop" focusable="true"/>
    <Group id="door">
      <Poster id="doorMark" uri="pkg:/images/wordmark.png" width="176" height="40"/>
      <Label id="welcome" text="Welcome home."/>
      <ButtonRow id="doorButtons"/>
      <Label id="doorNote" width="1000" wrap="true" maxLines="3"/>
    </Group>
    <!-- Use a local server: the servers that answered on this network, then a typed address -->
    <Group id="local" visible="false">
      <Poster id="localMark" uri="pkg:/images/wordmark.png" width="176" height="40"/>
      <Label id="localTitle" text="Use a local server"/>
      <Label id="localBody" text="Servers on this Wi‑Fi turn up by themselves. Anywhere else, type its address."/>
      <Label id="nearbyLabel"/>
      <Group id="nearbyRows"/>
      <Label id="elsewhereLabel" text="Somewhere else"/>
      <ButtonRow id="localButtons"/>
      <Label id="localNote" width="1400" wrap="true" maxLines="2"/>
    </Group>
    <Group id="code" visible="false">
      <Poster id="codeMark" uri="pkg:/images/wordmark.png" width="176" height="40"/>
      <Label id="eyebrow" text="Sign in to"/>
      <Label id="server" width="860"/>
      <!-- 760 wide, as auth.html .tvl .lede: the steps break where auth-02 breaks them -->
      <MultiStyleLabel id="how" width="760" wrap="true" maxLines="4"/>
      <ButtonRow id="codeButtons"/>
      <Label id="codeNote" width="820" wrap="true" maxLines="2"/>
      <KeyHints id="press" small="true"/>
      <QrCard id="card" note="This code refreshes by itself. Leave this screen open while you sign in."/>
    </Group>
    <Group id="factor" visible="false">
      <Poster id="factorMark" uri="pkg:/images/wordmark.png" width="176" height="40"/>
      <Label id="factorTitle" text="Enter your two-step code" width="900"/>
      <Label id="factorBody" text="Open your authenticator app and enter the six-digit code for this server." width="820" wrap="true" maxLines="3"/>
      <PinPad id="factorPad" digits="6"/>
    </Group>
    <!-- Sign in with Portico Account: its code, the account's servers, and the pages on the way -->
    <AccountPages id="account" visible="false"/>
    <Timer id="poll" duration="3"/>
    <!-- Sign in with Portico Account: its code, the account's servers, and the pages on the way -->
    <AccountPages id="account" visible="false"/>
  </children>
</component>
