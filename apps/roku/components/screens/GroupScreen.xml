<?xml version="1.0" encoding="utf-8"?>
<!-- A page that is a heading and rows of titles (frames().group, tv-detail frames 9 and 10): a
     collection (its titles in collection order), or a person (one row for each kind of work, in the
     order the server lists them, newest first). The words sit in fixed slots and the rows on a fixed
     line, so nothing moves when the words arrive. Focus starts on the first card. -->
<component name="GroupScreen" extends="Group">
  <interface>
    <!-- A collection item, {kind: "person", id, title} for a person, or {kind: "savedList", id, title,
         eyebrow, heading, path, summary, counts, images} for a saved view from Saved (a playlist or collection opens ListScreen). -->
    <field id="item" type="assocarray" onChange="onItem"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="art" type="string"/>
    <field id="quiet" type="boolean"/>
    <field id="open" type="assocarray" alwaysNotify="true"/>
    <!-- Asks the scene for the side sheet (a title's menu on *, a person's Filters); the choice comes back in menuChosen. -->
    <field id="menu" type="assocarray" alwaysNotify="true"/>
    <field id="menuChosen" type="string" alwaysNotify="true" onChange="onMenuChosen"/>
  </interface>
  <script type="text/brightscript" uri="GroupScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/CardMenu.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <children>
    <!-- Holds focus for the biography: the page cannot take focus back from its own Filters row or reader. -->
    <Group id="aboutStop" focusable="true"/>
    <Group id="rows"/>
    <Group id="head">
      <Face id="face" visible="false"/>
      <Group id="words">
        <Label id="eyebrow"/>
        <Label id="name"/>
        <Label id="factsStrong"/>
        <Label id="facts"/>
        <!-- A person's biography is a stop of its own: the plate and ring while it has focus. -->
        <Group id="aboutStop">
          <Poster id="aboutRing" uri="pkg:/images/focus-14.9.png" visible="false"/>
          <Poster id="aboutPlate" uri="pkg:/images/round-14.9.png" visible="false"/>
        </Group>
        <Label id="about" wrap="true"/>
      </Group>
      <!-- A collection's Play all and Shuffle, in the action row's fixed slot. -->
      <ButtonRow id="actions" visible="false"/>
      <!-- A person's Filters (All, Cast, Crew), at the end of the first row's heading. -->
      <ButtonRow id="filters" visible="false"/>
    </Group>
    <TextPanel id="reader"/>
    <Label id="smallTitle" visible="false"/>
    <PageState id="state" visible="false"/>
  </children>
</component>
