<?xml version="1.0" encoding="utf-8"?>
<!-- A page that is a heading and rows of titles (frames().group, tv-detail frames 9 and 10): a
     collection (its titles in collection order), or a person (one row for each kind of work, in the
     order the server lists them, newest first). The words sit in fixed slots and the rows on a fixed
     line, so nothing moves when the words arrive. Focus starts on the first card. -->
<component name="GroupScreen" extends="Group">
  <interface>
    <!-- A collection item, or {kind: "person", id, title} for a person. -->
    <field id="item" type="assocarray" onChange="onItem"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="art" type="string"/>
    <field id="quiet" type="boolean"/>
    <field id="open" type="assocarray" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="GroupScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <children>
    <Group id="rows"/>
    <Group id="head">
      <Face id="face" visible="false"/>
      <Group id="words">
        <Label id="eyebrow"/>
        <Label id="name"/>
        <Label id="factsStrong"/>
        <Label id="facts"/>
        <Label id="about" wrap="true"/>
      </Group>
    </Group>
    <Label id="smallTitle" visible="false"/>
    <PageState id="state" visible="false"/>
  </children>
</component>
