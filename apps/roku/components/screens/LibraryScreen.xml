<?xml version="1.0" encoding="utf-8"?>
<!-- A library (frame "Browse"; tv.html frame 4): its name and views, one toolbar (Sort, then the quick
     filters the library offers), the count, then the grid. Three regions down the page: the views,
     the toolbar, the grid. Focus starts on the first card. -->
<component name="LibraryScreen" extends="Group">
  <interface>
    <!-- {id, name, kind} from the rail. -->
    <field id="library" type="assocarray" onChange="onLibrary"/>
    <!-- Or one list as a grid with its title and count, no toolbar: {kind: "list", title, path,
         view}. Search's "See all" for one kind (path is that search with kind) and a genre's titles. -->
    <field id="item" type="assocarray" onChange="onItem"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="art" type="string"/>
    <!-- Set to the id of another library of the same kind chosen from the name's menu: the scene opens it. -->
    <field id="switchTo" type="string" alwaysNotify="true"/>
    <field id="open" type="assocarray" alwaysNotify="true"/>
    <field id="menu" type="assocarray" alwaysNotify="true"/>
    <field id="menuChosen" type="string" alwaysNotify="true" onChange="onMenuChosen"/>
    <field id="menuClosed" type="boolean" alwaysNotify="true" onChange="onMenuClosed"/>
    <field id="toTop" type="boolean" alwaysNotify="true" onChange="onToTop"/>
    <!-- Set when an empty library's Browse Home is pressed. -->
    <field id="goHome" type="boolean" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="LibraryScreen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <children>
    <Label id="name"/>
    <!-- Beside the name when other libraries hold the same kind: OK on the name lists them. -->
    <Poster id="chevron" uri="pkg:/images/i-chevronDown-20.png" width="20" height="20" visible="false"/>
    <Group id="views"/>
    <Rectangle id="viewMark" height="3" visible="false"/>
    <Poster id="viewRing" uri="pkg:/images/focus-14.9.png" visible="false"/>
    <Group id="tools"/>
    <Group id="chips"/>
    <Label id="count"/>
    <MarkupGrid id="grid" itemComponentName="Card" numColumns="7" numRows="3"
                drawFocusFeedback="false" vertFocusAnimationStyle="fixedFocus"/>
    <StateRow id="gridState" visible="false"/>
    <!-- The Discover tab: the library's own Home rows, drawn by Home itself. Made when first shown. -->
    <Group id="discover"/>
    <PageState id="page" visible="false"/>
  </children>
</component>
