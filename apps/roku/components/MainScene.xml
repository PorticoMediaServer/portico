<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" onChange="onLaunchArgs"/>
    <!-- A title Roku asks the running app to open: {contentId, mediaType}. -->
    <field id="deepLink" type="assocarray" alwaysNotify="true" onChange="onDeepLink"/>
  </interface>
  <script type="text/brightscript" uri="MainScene.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Store.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Settings.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Address.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Capabilities.brs"/>
  <children>
    <Backdrop id="backdrop"/>
    <Group id="screens"/>
    <!-- Now playing for music and audiobooks: the scene's own, over the pages, not one of them. -->
    <AudioScreen id="audioPlayer" visible="false"/>
    <!-- While music plays and its screen is away: the small card at the top right of every page. -->
    <NowPlaying id="nowPlaying" visible="false"/>
    <Rail id="rail" visible="false"/>
    <Sheet id="sheet" visible="false"/>
    <!-- The Watch Together group this profile is in: the room page and the player share it. -->
    <TogetherRoom id="together"/>
    <!-- Signing out asks first, wherever it was chosen (the rail's profile menu, later Settings too). -->
    <Confirm id="confirm" visible="false"/>
    <!-- Development builds only: counts drawn frames, for judging smoothness without eyes on the screen. -->
    <Rectangle id="frameProbe" width="1" height="1" opacity="0"/>
    <Animation id="frameClock" duration="1" repeat="true" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 0.01]" fieldToInterp="frameProbe.opacity"/>
    </Animation>
    <!-- A name typed on the TV (a new playlist or collection): asked for by a page, over everything. -->
    <NamePanel id="namePanel"/>
  </children>
</component>
