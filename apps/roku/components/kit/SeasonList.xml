<?xml version="1.0" encoding="utf-8"?>
<!-- A show's seasons, down the left of its page. Five show at once; when there are more, the next
     one peeks in half faded below (and above, once the list has moved), so it is plain the list goes on. -->
<component name="SeasonList" extends="Group">
  <interface>
    <!-- [{title, text, progress}] -->
    <field id="seasons" type="array" onChange="onSeasons"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <!-- The season in focus (or last in focus); set it to choose the starting one. -->
    <field id="index" type="integer" value="0" onChange="paint"/>
  </interface>
  <script type="text/brightscript" uri="SeasonList.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <children>
    <Group id="window">
      <Poster id="plate" uri="pkg:/images/round-14.9.png" blendColor="0x162C3AFF" width="350" height="90" translation="[-10,0]"/>
      <Group id="rows"/>
    </Group>
    <Poster id="fadeTop" uri="pkg:/images/fade-up.png" width="380" height="60" translation="[-20,0]" visible="false"/>
    <Poster id="fadeBottom" uri="pkg:/images/fade-down.png" width="380" height="72" translation="[-20,468]"  visible="false"/>
    <Poster id="ring" uri="pkg:/images/focus-14.9.png" width="422" height="162" visible="false"/>
  </children>
</component>
