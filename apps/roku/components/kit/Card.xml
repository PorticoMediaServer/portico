<?xml version="1.0" encoding="utf-8"?>
<!-- One card, for every row and grid. Its content node says what to draw:
     art (address), title, sub, progress (0 to 1, below 0 for none), badge, overlay (text over the art, as on wide cards). -->
<component name="Card" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent"/>
    <field id="width" type="float" onChange="onLayout"/>
    <field id="height" type="float" onChange="onLayout"/>
    <field id="focusPercent" type="float" onChange="onFocus"/>
    <field id="rowListHasFocus" type="boolean" onChange="onFocus"/>
    <field id="gridHasFocus" type="boolean" onChange="onFocus"/>
    <field id="itemHasFocus" type="boolean" onChange="onFocus"/>
  </interface>
  <script type="text/brightscript" uri="Card.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <children>
    <!-- Roku rounds a picture's corners only through a mask, and a masked group ignores scale. So the
         card in focus grows in two ways at once: the plate and the words by scale, the masked
         picture by being drawn larger. -->
    <Group id="frame">
    <!-- In a grid, focus moves from card to card, so the card draws its own ring (a row draws one at its slot). -->
    <Poster id="ownRing" uri="pkg:/images/focus-14.9.png" visible="false"/>
    <Group id="under">
      <Poster id="plate" uri="pkg:/images/round-14.9.png"/>
    </Group>
    <MaskGroup id="clip">
      <Poster id="art" loadDisplayMode="scaleToZoom"/>
      <!-- A collection's mosaic: four of its titles' posters, two by two (collections.html frame 16). -->
      <Group id="tiles" visible="false">
        <Poster loadDisplayMode="scaleToZoom"/>
        <Poster loadDisplayMode="scaleToZoom"/>
        <Poster loadDisplayMode="scaleToZoom"/>
        <Poster loadDisplayMode="scaleToZoom"/>
      </Group>
      <Poster id="shade" uri="pkg:/images/card-shade.png" visible="false"/>
    </MaskGroup>
    <!-- A person: a round face (a portrait, or initials on a disc) with the name and part under it. -->
    <Group id="person" visible="false" translation="[0,16]">
      <Poster id="faceDisc" uri="pkg:/images/disc.png" width="150" height="150"/>
      <Label id="faceInitials" width="150" height="150" horizAlign="center" vertAlign="center"/>
      <MaskGroup id="faceClip" maskUri="pkg:/images/disc.png" maskSize="[150,150]">
        <Poster id="facePhoto" width="150" height="150" loadWidth="150" loadHeight="150" loadDisplayMode="scaleToZoom"/>
      </MaskGroup>
      <Label id="faceName" horizAlign="center"/>
      <Label id="facePart" horizAlign="center"/>
    </Group>
    <Group id="over">
      <!-- A title with no picture gets a cover made from its name: one of eight tints, the same in every Portico app. -->
      <Group id="made" visible="false">
        <Label id="madeGlyph" horizAlign="right" opacity="0.085"/>
        <Rectangle id="madeRule" height="3"/>
        <Label id="madeTitle" wrap="true" maxLines="5"/>
      </Group>
      <Label id="title" visible="false"/>
      <Label id="sub" visible="false"/>
      <Rectangle id="track" height="6" visible="false"/>
      <Rectangle id="bar" height="6" visible="false"/>
      <!-- An episode's still carries its length, and a tick once it has been played. -->
      <Poster id="cornerPlate" uri="pkg:/images/round-6.9.png" height="36" visible="false"/>
      <Label id="corner" height="36" vertAlign="center" visible="false"/>
      <Poster id="tickPlate" uri="pkg:/images/disc.png" width="40" height="40" translation="[14,14]" visible="false"/>
      <Poster id="tick" uri="pkg:/images/i-check-28.png" width="24" height="24" translation="[22,22]" visible="false"/>
      <Poster id="badgePlate" uri="pkg:/images/round-6.9.png" visible="false"/>
      <Label id="badge" visible="false"/>
    </Group>
    </Group>
  </children>
</component>
