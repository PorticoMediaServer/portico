<?xml version="1.0" encoding="utf-8"?>
<!-- The lower part of every title page: the section strip (a marker, never a focus stop), the
     More like this row, and Details with the facts and the cast. A show's page adds its own first
     section (Episodes) and draws that itself. -->
<component name="TitleSections" extends="Group">
  <interface>
    <!-- The title in full, as GET /v1/items/{id} answers. -->
    <field id="item" type="assocarray" onChange="onItem"/>
    <!-- Name of the page's own first section ("Episodes"), or "" for none. -->
    <field id="lead" type="string" onChange="place"/>
    <!-- Which section is shown: "lead", "related" or "details". -->
    <field id="section" type="string" value="related" onChange="place"/>
    <field id="hasRelated" type="boolean"/>
    <!-- The More like this card in focus (its item), for the title page's * menu. -->
    <field id="focusedRelated" type="assocarray"/>
    <!-- True once the page has folded up below its hero: More like this then has its heading. -->
    <field id="folded" type="boolean" onChange="place"/>
    <!-- A show's page: while its own first section shows, More like this peeks in below it. -->
    <field id="peek" type="boolean" onChange="place"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <!-- True while the strip itself has focus (tv-detail frame 3: Up from a section reaches it, Left
         and Right jump between sections): the tab of the section shown takes the focus ring. -->
    <field id="stripOn" type="boolean" onChange="place"/>
    <!-- A related title was chosen: the item. -->
    <field id="chosen" type="assocarray" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="TitleSections.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Present.brs"/>
  <children>
    <Label id="tabLead"/>
    <Label id="tabRelated" text="More like this"/>
    <Label id="tabDetails" text="Details"/>
    <Rectangle id="rule" height="1"/>
    <Rectangle id="mark" height="3"/>
    <Poster id="tabRing" uri="pkg:/images/focus-14.9.png" visible="false"/>
    <Shelf id="related" shape="poster" visible="false"/>
    <Group id="details" translation="[0,90]" visible="false">
      <Label id="aboutHead" text="About"/>
      <Label id="about" width="880" wrap="true" maxLines="5"/>
      <Label id="tagline" width="880"/>
      <Group id="facts"/>
      <Shelf id="cast" shape="person" heading="Cast &amp; crew" subheading="Cast, then crew" translation="[0,330]"/>
    </Group>
  </children>
</component>
