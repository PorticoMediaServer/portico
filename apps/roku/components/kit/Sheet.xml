<?xml version="1.0" encoding="utf-8"?>
<!-- The side sheet (frame "sheet"): a title's menu, the choices of one setting, or the player's
     options. It is opaque, holds focus until it closes, enters on the current choice (or the first
     row), and Back closes it. A row can be a heading with its choices under it: they open in place
     under the heading, one heading open at a time. -->
<component name="Sheet" extends="Group">
  <interface>
    <!-- {eyebrow, title, status, body, open, rows: [{id, text, icon, current, gapBefore, detail,
         heading, value, under, focus, label}]}: `heading` rows carry their current `value` on the right
         (any other row may carry one too: a language's place in its list); a row with `under` set
         to a heading's id shows only while that heading is open; `open` names the heading open at
         the start; `focus` starts focus on a row that is not the current choice; `label` is a group's
         name or a line of help, words only, which focus passes over; `hints`, the remote's
         keys at the foot ([{keys, text}], kit/KeyHints), and the rows stop above them. -->
    <field id="model" type="assocarray" onChange="onModel"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <!-- A row may also say `dot`: a recording's red dot in place of its icon (Record). A programme's
         sheet (tv.html frame 6) adds to the model: `mark`, a channel ({name, logo}) whose badge goes
         before the eyebrow; `live`, the red Live tag at the right of that line; `progress` (0 to 1),
         how far in, under the status; `later` {heading, lines: [{time, title}]}, what follows it. -->
    <!-- The row chosen with OK. -->
    <field id="chosen" type="string" alwaysNotify="true"/>
    <!-- Set true when Back closes the sheet without a choice. -->
    <field id="dismissed" type="boolean" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="Sheet.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <children>
    <Rectangle id="scrim" width="1920" height="1080" opacity="0.5"/>
    <Rectangle id="panel" height="1080"/>
    <ChannelMark id="mark" visible="false"/>
    <Label id="eyebrow"/>
    <Poster id="liveDot" uri="pkg:/images/disc.png" width="10" height="10" visible="false"/>
    <Label id="liveTag" text="Live" visible="false"/>
    <Rectangle id="progressTrack" height="6" visible="false"/>
    <Rectangle id="progressBar" height="6" visible="false"/>
    <Label id="title" wrap="true" maxLines="2"/>
    <Label id="status" wrap="true" maxLines="5"/>
    <!-- Optional words under the status, such as a programme's summary. -->
    <Label id="body" wrap="true" maxLines="6"/>
    <Group id="later"/>
    <Group id="window">
      <Group id="groups"/>
      <Poster id="plate" uri="pkg:/images/round-14.9.png"/>
      <Group id="rows"/>
    </Group>
    <Poster id="ring" uri="pkg:/images/focus-14.9.png"/>
    <KeyHints id="hints"/>
  </children>
</component>
