<?xml version="1.0" encoding="utf-8"?>
<!-- A row of buttons that takes focus as one region: Left and Right move, the ends stop, OK presses. -->
<component name="ButtonRow" extends="Group">
  <interface>
    <!-- [{id, text, icon}], for Resume also {progress, detail}, danger for a destructive one, and
         switchedOn for a chip that is on -->
    <field id="buttons" type="array" onChange="onButtons"/>
    <!-- The id of the one button that widens to keep the others in their places when the row is
         redrawn with a button gone or a label changed (a title page's Play, rule 12); "" for none. -->
    <field id="flexible" type="string"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="pressed" type="string" alwaysNotify="true"/>
    <!-- A button's spec may also say switchedOn (a filter chip that is on) or menu (it opens a menu).
         Set by the row: the button in focus, for a page that slides a long row of chips. -->
    <field id="focusedIndex" type="integer"/>
    <!-- Right from the last button goes on to the page (a column beside the row, as in Watch
         Together's room) instead of stopping there. -->
    <field id="passRight" type="boolean"/>
  </interface>
  <script type="text/brightscript" uri="ButtonRow.brs"/>
</component>
