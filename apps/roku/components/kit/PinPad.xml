<?xml version="1.0" encoding="utf-8"?>
<!-- The number pad and its boxes: a profile PIN (4 digits) or a two-step code (6). The pad keeps
     its column on Up and Down; typing never moves focus; the last digit submits. -->
<component name="PinPad" extends="Group">
  <interface>
    <field id="digits" type="integer" value="4" onChange="reset"/>
    <!-- Text of the button under the pad ("Forgot PIN?"), or "" for none. -->
    <field id="extra" type="string" onChange="reset"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <field id="entered" type="string" alwaysNotify="true"/>
    <field id="extraPressed" type="boolean" alwaysNotify="true"/>
    <!-- Set true after a wrong entry: the boxes show the error colour, then empty. -->
    <field id="wrong" type="boolean" alwaysNotify="true" onChange="onWrong"/>
    <!-- Where the boxes are drawn, relative to the pad. -->
    <field id="boxesAt" type="vector2d" value="[-850,462]" onChange="reset"/>
  </interface>
  <script type="text/brightscript" uri="PinPad.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <children>
    <Group id="boxes"/>
    <Group id="keys"/>
    <Poster id="ring" uri="pkg:/images/focus-14.9.png"/>
    <Timer id="clear" duration="0.4"/>
  </children>
</component>
