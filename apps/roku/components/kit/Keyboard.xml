<?xml version="1.0" encoding="utf-8"?>
<!-- Portico's own keyboard (Search; an invitation code): columns that keep their column on Up and
     Down, then Space, delete and Clear. Typing never moves focus; it remembers its key when focus
     comes back. Set `characters`, `columns` and `width` before it is shown. -->
<component name="Keyboard" extends="Group">
  <interface>
    <field id="text" type="string" alwaysNotify="true"/>
    <!-- A key name (Lit_a, backspace) a page passes on while focus is not on the keyboard. -->
    <field id="typed" type="string" alwaysNotify="true" onChange="onTyped"/>
    <field id="active" type="boolean" alwaysNotify="true" onChange="onActive"/>
    <!-- Letters drawn in capitals (an invitation code, which is shown in capitals); what is typed
         is the same either way. -->
    <field id="capitals" type="boolean" onChange="onCapitals"/>
    <!-- The keys, in order, and how many to a row; the width the columns share (Search: 6 across 500). -->
    <field id="characters" type="string" value="abcdefghijklmnopqrstuvwxyz1234567890" onChange="build"/>
    <field id="columns" type="integer" value="6" onChange="build"/>
    <field id="width" type="integer" value="500" onChange="build"/>
  </interface>
  <script type="text/brightscript" uri="Keyboard.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Theme.brs"/>
  <script type="text/brightscript" uri="pkg:/components/kit/Hold.brs"/>
  <children>
    <Group id="keys"/>
    <Poster id="ring" uri="pkg:/images/focus-14.9.png" visible="false"/>
  </children>
</component>
