{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portico",
  "version": "0.1.0",
  "identifier": "tv.getportico.desktop.spike",
  "build": {"frontendDist": "../dist", "devUrl": "http://127.0.0.1:14229"},
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "capabilities": ["desktop"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; font-src 'self'; media-src 'self' blob: http: https:; connect-src ipc: http://ipc.localhost 'self' http: https: wss: ws:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false, "targets": ["deb", "appimage"], "category": "Entertainment",
    "shortDescription": "Portico media player", "copyright": "Portico contributors", "license": "GPL-3.0-only",
    "linux": {
      "deb": {"depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-gl", "at-spi2-core"]},
      "appimage": {"bundleMediaFramework": true}
    }
  }
}
