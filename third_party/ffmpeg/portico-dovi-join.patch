+++ b/libavformat/dovi_join.c
@@ -0,0 +1,288 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Bounded opt-in dual-PID Dolby Vision join. No residual reconstruction.
+ * Source PMT authority and stream identity are supplied by the MPEGTS reader.
+ */
+#include <libdovi/rpu_parser.h>
+#include "libavcodec/avcodec.h"
+#include "libavutil/mem.h"
+#include "dovi_join.h"
+
+#define AU_MAX (8 * 1024 * 1024)
+#define QUEUE_MAX 32
+#define BYTES_MAX (32 * 1024 * 1024)
+
+typedef struct JoinLayer {
+    AVCodecParserContext *parser;
+    AVCodecContext *codec;
+    AVPacket *queue[QUEUE_MAX];
+    int poc[QUEUE_MAX];
+    unsigned count;
+    size_t pending;
+} JoinLayer;
+
+struct FFDoviJoin {
+    AVFormatContext *format;
+    JoinLayer layers[2];
+    size_t queued;
+    int stream_index;
+    int error;
+    int finished;
+};
+
+static int fail(FFDoviJoin *join, int error)
+{
+    join->error = error;
+    av_log(join->format, AV_LOG_ERROR, "Dolby Vision dual-PID join failed; refusing unmatched or unqualified output.\n");
+    return error;
+}
+
+static size_t start(const uint8_t *data, size_t size, size_t from, size_t *prefix)
+{
+    for (size_t i = from; i + 2 < size; i++) {
+        if (data[i] || data[i+1])
+            continue;
+        if (data[i+2] == 1) {
+            *prefix = 3;
+            return i;
+        }
+        if (!data[i+2] && i + 3 < size && data[i+3] == 1) {
+            *prefix = 4;
+            return i;
+        }
+    }
+    *prefix = 0;
+    return size;
+}
+
+static int inspect(const AVPacket *packet, int el, size_t *extra)
+{
+    size_t prefix, at = start(packet->data, packet->size, 0, &prefix);
+    int rpus = 0, pictures = 0;
+    if (at || !prefix)
+        return AVERROR_INVALIDDATA;
+    *extra = 0;
+    while (at < (size_t)packet->size) {
+        size_t next_prefix, next = start(packet->data, packet->size, at + prefix, &next_prefix);
+        const uint8_t *nal = packet->data + at + prefix;
+        size_t size = next - at - prefix;
+        if (size < 2 || !(nal[1] & 7) || (nal[0] & 0x80))
+            return AVERROR_INVALIDDATA;
+        int type = (nal[0] >> 1) & 63;
+        pictures += type <= 31;
+        if (type == 63 || (!el && type == 62))
+            return AVERROR_INVALIDDATA;
+        if (type == 62) {
+            DoviRpuOpaque *rpu = dovi_parse_unspec62_nalu(nal, size);
+            const DoviRpuDataHeader *header = rpu && !dovi_rpu_get_error(rpu) ? dovi_rpu_get_header(rpu) : NULL;
+            int valid = header && header->guessed_profile == 7;
+            dovi_rpu_free_header(header);
+            dovi_rpu_free(rpu);
+            if (!valid)
+                return AVERROR_INVALIDDATA;
+            rpus++;
+        }
+        if (el)
+            *extra += 4 + size + (type != 62 ? 2 : 0);
+        at = next;
+        prefix = next_prefix;
+    }
+    return pictures && rpus == el ? 0 : AVERROR_INVALIDDATA;
+}
+
+static int queue_au(FFDoviJoin *join, JoinLayer *layer, uint8_t *data, int size)
+{
+    if (size <= 0 || size > AU_MAX || layer->count >= QUEUE_MAX || join->queued + size > BYTES_MAX ||
+        layer->parser->pts == AV_NOPTS_VALUE || layer->parser->dts == AV_NOPTS_VALUE)
+        return fail(join, AVERROR_INVALIDDATA);
+    AVPacket *packet = av_packet_alloc();
+    if (!packet)
+        return fail(join, AVERROR(ENOMEM));
+    int ret = av_new_packet(packet, size);
+    if (ret < 0) {
+        av_packet_free(&packet);
+        return fail(join, ret);
+    }
+    memcpy(packet->data, data, size);
+    packet->pts = layer->parser->pts;
+    packet->dts = layer->parser->dts;
+    packet->pos = layer->parser->pos;
+    if (layer->parser->key_frame == 1)
+        packet->flags |= AV_PKT_FLAG_KEY;
+    layer->poc[layer->count] = layer->parser->output_picture_number;
+    layer->queue[layer->count++] = packet;
+    join->queued += size;
+    layer->pending -= FFMIN(layer->pending, (size_t)size);
+    return 0;
+}
+
+static int parse(FFDoviJoin *join, int which, const AVPacket *packet)
+{
+    JoinLayer *layer = &join->layers[which];
+    const uint8_t *data = packet ? packet->data : NULL;
+    int size = packet ? packet->size : 0;
+    int64_t pts = packet ? packet->pts : AV_NOPTS_VALUE;
+    int64_t dts = packet ? packet->dts : AV_NOPTS_VALUE;
+    int64_t pos = packet ? packet->pos : -1;
+    int got = 1;
+    if (size < 0 || size > AU_MAX || layer->pending + size > AU_MAX ||
+        (packet && packet->flags & AV_PKT_FLAG_CORRUPT))
+        return fail(join, AVERROR_INVALIDDATA);
+    layer->pending += size;
+    while (size > 0 || (!packet && got)) {
+        uint8_t *out;
+        int out_size;
+        int consumed = av_parser_parse2(layer->parser, layer->codec, &out, &out_size,
+                                        data, size, pts, dts, pos);
+        if (consumed < 0 || consumed > size || (!consumed && !out_size && size))
+            return fail(join, AVERROR_INVALIDDATA);
+        pts = dts = AV_NOPTS_VALUE;
+        pos = -1;
+        data = consumed ? data + consumed : data;
+        size -= consumed;
+        got = !!out_size;
+        if (out_size) {
+            int ret = queue_au(join, layer, out, out_size);
+            if (ret < 0)
+                return ret;
+        }
+    }
+    return 0;
+}
+
+int ff_dovi_join_alloc(FFDoviJoin **out, AVFormatContext *format, AVStream *bl, AVStream *el)
+{
+    if (*out || bl == el || bl->codecpar->codec_id != AV_CODEC_ID_HEVC || el->codecpar->codec_id != AV_CODEC_ID_HEVC ||
+        av_cmp_q(bl->time_base, el->time_base))
+        return AVERROR_INVALIDDATA;
+    FFDoviJoin *join = av_mallocz(sizeof(*join));
+    if (!join)
+        return AVERROR(ENOMEM);
+    join->format = format;
+    join->stream_index = bl->index;
+    for (int i = 0; i < 2; i++) {
+        JoinLayer *layer = &join->layers[i];
+        layer->codec = avcodec_alloc_context3(NULL);
+        layer->parser = av_parser_init(AV_CODEC_ID_HEVC);
+        if (!layer->codec || !layer->parser) {
+            ff_dovi_join_free(&join);
+            return AVERROR(ENOMEM);
+        }
+        int ret = avcodec_parameters_to_context(layer->codec, (i ? el : bl)->codecpar);
+        if (ret < 0) {
+            ff_dovi_join_free(&join);
+            return ret;
+        }
+    }
+    *out = join;
+    return 0;
+}
+
+int ff_dovi_join_push(FFDoviJoin *join, int which, const AVPacket *packet)
+{
+    if (join->error)
+        return join->error;
+    if (which < 0 || which > 1 || !packet || join->finished)
+        return fail(join, AVERROR(EINVAL));
+    return parse(join, which, packet);
+}
+
+int ff_dovi_join_receive(FFDoviJoin *join, AVPacket *packet)
+{
+    if (join->error)
+        return join->error;
+    JoinLayer *bl = &join->layers[0], *el = &join->layers[1];
+    if (!bl->count || !el->count) {
+        if (join->finished)
+            return bl->count || el->count ? fail(join, AVERROR_INVALIDDATA) : AVERROR_EOF;
+        return AVERROR(EAGAIN);
+    }
+    AVPacket *base = bl->queue[0], *enhancement = el->queue[0];
+    if (base->pts != enhancement->pts || base->dts != enhancement->dts || bl->poc[0] != el->poc[0])
+        return fail(join, AVERROR_INVALIDDATA);
+    size_t extra;
+    if (inspect(base, 0, &extra) < 0 || inspect(enhancement, 1, &extra) < 0 || extra + base->size > AU_MAX)
+        return fail(join, AVERROR_INVALIDDATA);
+    int ret = av_new_packet(packet, base->size + extra);
+    if (ret < 0)
+        return fail(join, ret);
+    ret = av_packet_copy_props(packet, base);
+    if (ret < 0) {
+        av_packet_unref(packet);
+        return fail(join, ret);
+    }
+    packet->stream_index = join->stream_index;
+    memcpy(packet->data, base->data, base->size);
+    uint8_t *write = packet->data + base->size;
+    size_t prefix, at = start(enhancement->data, enhancement->size, 0, &prefix);
+    while (at < (size_t)enhancement->size) {
+        size_t next_prefix, next = start(enhancement->data, enhancement->size, at + prefix, &next_prefix);
+        const uint8_t *nal = enhancement->data + at + prefix;
+        size_t size = next - at - prefix;
+        memcpy(write, "\0\0\0\1", 4); write += 4;
+        if (((nal[0] >> 1) & 63) != 62) {
+            *write++ = 0x7e;
+            *write++ = 1;
+        }
+        memcpy(write, nal, size); write += size;
+        at = next; prefix = next_prefix;
+    }
+    join->queued -= base->size + enhancement->size;
+    for (int i = 0; i < 2; i++) {
+        JoinLayer *layer = &join->layers[i];
+        av_packet_free(&layer->queue[0]);
+        layer->count--;
+        memmove(layer->queue, layer->queue + 1, layer->count * sizeof(*layer->queue));
+        memmove(layer->poc, layer->poc + 1, layer->count * sizeof(*layer->poc));
+    }
+    return 0;
+}
+
+int ff_dovi_join_finish(FFDoviJoin *join)
+{
+    if (join->error)
+        return join->error;
+    if (!join->finished) {
+        for (int i = 0; i < 2; i++) {
+            int ret = parse(join, i, NULL);
+            if (ret < 0)
+                return ret;
+        }
+        join->finished = 1;
+    }
+    return 0;
+}
+
+int ff_dovi_join_flush(FFDoviJoin *join)
+{
+    if (join->error)
+        return join->error;
+    for (int i = 0; i < 2; i++) {
+        JoinLayer *layer = &join->layers[i];
+        for (unsigned j = 0; j < layer->count; j++)
+            av_packet_free(&layer->queue[j]);
+        av_parser_close(layer->parser);
+        layer->parser = av_parser_init(AV_CODEC_ID_HEVC);
+        if (!layer->parser)
+            return fail(join, AVERROR(ENOMEM));
+        layer->count = 0;
+        layer->pending = 0;
+    }
+    join->queued = 0;
+    join->finished = 0;
+    return 0;
+}
+
+void ff_dovi_join_free(FFDoviJoin **ptr)
+{
+    FFDoviJoin *join = *ptr;
+    if (!join)
+        return;
+    for (int i = 0; i < 2; i++) {
+        JoinLayer *layer = &join->layers[i];
+        for (unsigned j = 0; j < layer->count; j++)
+            av_packet_free(&layer->queue[j]);
+        av_parser_close(layer->parser);
+        avcodec_free_context(&layer->codec);
+    }
+    av_freep(ptr);
