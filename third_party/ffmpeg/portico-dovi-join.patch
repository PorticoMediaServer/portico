+static int mpegts_read_packet(AVFormatContext *s, AVPacket *pkt)
+{
+#if CONFIG_LIBDOVI
+    MpegTSContext *ts = s->priv_data;
+    int ret;
+    if (!ts->merge_dovi)
+        return mpegts_read_packet_unmerged(s, pkt);
+    if (ts->dovi_join && avio_tell(s->pb) != ts->last_pos) {
+        ret = ff_dovi_join_flush(ts->dovi_join);
+        if (ret < 0)
+            return ts->dovi_error = ret;
+    }
+    for (;;) {
+        if (ts->dovi_error)
+            return ts->dovi_error;
+        if (ts->dovi_join) {
+            ret = ff_dovi_join_receive(ts->dovi_join, pkt);
+            if (ret != AVERROR(EAGAIN))
+                return ret;
+        }
+        /* FFmpeg drops unmapped PES streams. The dependent EL is an input
+         * to the selected BL even though it never emits a separate packet. */
+        if (ts->dovi_base_pid)
+            for (unsigned i = 0; i < s->nb_streams; i++)
+                if (s->streams[i]->id == ts->dovi_base_pid || s->streams[i]->id == ts->dovi_el_pid)
+                    s->streams[i]->discard = AVDISCARD_NONE;
+        ret = mpegts_read_packet_unmerged(s, pkt);
+        if (ts->dovi_error) {
+            av_packet_unref(pkt);
+            return ts->dovi_error;
+        }
+        if (ret < 0) {
+            if (ret == AVERROR_EOF && ts->dovi_join) {
+                ret = ff_dovi_join_finish(ts->dovi_join);
+                return ret < 0 ? ret : ff_dovi_join_receive(ts->dovi_join, pkt);
+            }
+            return ret;
+        }
+        if (!ts->dovi_base_pid)
+            return 0;
+        AVStream *bl = NULL, *el = NULL;
+        for (unsigned i = 0; i < s->nb_streams; i++) {
+            if (s->streams[i]->id == ts->dovi_base_pid)
+                bl = s->streams[i];
+            if (s->streams[i]->id == ts->dovi_el_pid)
+                el = s->streams[i];
+        }
+        if (!bl || !el) {
+            av_packet_unref(pkt);
+            return ts->dovi_error = AVERROR_INVALIDDATA;
