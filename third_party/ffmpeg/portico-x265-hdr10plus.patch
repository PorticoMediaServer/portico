+static int libx265_add_hdr_plus(libx265Context *ctx, x265_picture *picture,
+                                const AVFrame *frame)
+{
+    const AVFrameSideData *sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DYNAMIC_HDR_PLUS);
+    const AVDynamicHDRPlus *hdr;
+    x265_sei *sei = &picture->userSEI;
+    x265_sei_payload *item;
+    uint8_t *buffer, *payload;
+    void *tmp;
+    size_t size;
+    int ret;
+
+    if (!ctx->hdr10plus || !sd)
+        return 0;
+    if (sd->size != sizeof(AVDynamicHDRPlus))
+        return AVERROR_INVALIDDATA;
+    hdr = (const AVDynamicHDRPlus *)sd->data;
+    if (hdr->application_version != 1)
+        return AVERROR_INVALIDDATA;
+    ret = av_dynamic_hdr_plus_to_t35(hdr, NULL, &size);
+    if (ret < 0)
+        return ret;
+    if (!size || size > AV_HDR_PLUS_MAX_PAYLOAD_SIZE)
+        return AVERROR_INVALIDDATA;
+    buffer = av_malloc(size + 6);
+    if (!buffer)
+        return AVERROR(ENOMEM);
+    payload = buffer;
+    bytestream_put_byte(&payload, ITU_T_T35_COUNTRY_CODE_US);
+    bytestream_put_be16(&payload, ITU_T_T35_PROVIDER_CODE_SAMSUNG);
+    bytestream_put_be16(&payload, 0x0001);
+    bytestream_put_byte(&payload, 0x04);
+    ret = av_dynamic_hdr_plus_to_t35(hdr, &payload, &size);
+    if (ret < 0) {
+        av_free(buffer);
+        return ret;
+    }
+    tmp = av_fast_realloc(ctx->sei_data, &ctx->sei_data_size,
+                         (sei->numPayloads + 1) * sizeof(*item));
+    if (!tmp) {
+        av_free(buffer);
+        return AVERROR(ENOMEM);
+    }
+    ctx->sei_data = tmp;
+    sei->payloads = ctx->sei_data;
+    item = &sei->payloads[sei->numPayloads++];
+    item->payload = buffer;
+    item->payloadSize = size + 6;
+    item->payloadType = (SEIPayloadType)SEI_TYPE_USER_DATA_REGISTERED_ITU_T_T35;
+    return 0;
+}
