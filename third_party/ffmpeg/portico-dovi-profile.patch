+#include <libdovi/rpu_parser.h>
+
+#include "libavutil/buffer.h"
+#include "libavutil/dovi_meta.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "bsf.h"
+#include "bsf_internal.h"
+#include "cbs.h"
+#include "cbs_bsf.h"
+#include "hevc/hevc.h"
+
+typedef struct DoviProfileContext {
+    CBSBSFContext common;
+    int mode;
+    int seen_rpu;
+} DoviProfileContext;
+
+/* The input must be an observed dual-layer profile 7 stream. Conversion mode
+ * 2 produces profile 8.1 (FEL mapping removed), without reconstructing residuals.
+ * The BL and packet timestamps are retained. Every EL NAL is discarded. */
+static int convert_rpu(AVBSFContext *bsf, CodedBitstreamUnit *nal)
+{
+    DoviProfileContext *s = bsf->priv_data;
+    DoviRpuOpaque *rpu = NULL;
+    const DoviRpuDataHeader *header = NULL;
+    const DoviData *data = NULL;
+    AVBufferRef *ref = NULL;
+    int ret = AVERROR_INVALIDDATA;
+
+    /* CBS owns HEVC escaping: its unit data is already unescaped. */
+    if (nal->data_size < 3)
+        return AVERROR_INVALIDDATA;
+    rpu = dovi_parse_rpu(nal->data + 2, nal->data_size - 2);
+    if (!rpu)
+        return AVERROR(ENOMEM);
+    if (dovi_rpu_get_error(rpu))
+        goto fail;
+    header = dovi_rpu_get_header(rpu);
+    if (!header || header->guessed_profile != 7) {
+        av_log(bsf, AV_LOG_ERROR, "RPU is not profile 7; refusing conversion.\n");
+        goto fail;
+    }
+    dovi_rpu_free_header(header);
+    header = NULL;
+    if (dovi_convert_rpu_with_mode(rpu, s->mode) < 0 || dovi_rpu_get_error(rpu))
+        goto fail;
+    header = dovi_rpu_get_header(rpu);
+    if (!header || header->guessed_profile != 8)
+        goto fail;
+    data = dovi_write_rpu(rpu);
+    if (!data || !data->data || data->len < 3 ||
+        data->len > INT_MAX - 2 - AV_INPUT_BUFFER_PADDING_SIZE || dovi_rpu_get_error(rpu))
+        goto fail;
+    ref = av_buffer_allocz(data->len + 2 + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!ref) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    memcpy(ref->data, nal->data, 2);
+    memcpy(ref->data + 2, data->data, data->len);
+    av_buffer_unref(&nal->data_ref);
+    nal->data_ref = ref;
+    nal->data = ref->data;
+    nal->data_size = data->len + 2;
+    nal->data_bit_padding = 0;
+    s->seen_rpu = 1;
+    ret = 0;
+fail:
+    if (ret < 0 && dovi_rpu_get_error(rpu))
+        av_log(bsf, AV_LOG_ERROR, "libdovi: %s\n", dovi_rpu_get_error(rpu));
+    dovi_data_free(data);
+    dovi_rpu_free_header(header);
+    dovi_rpu_free(rpu);
+    return ret;
+}
+
+static int update_config(AVBSFContext *bsf, AVDOVIDecoderConfigurationRecord *cfg)
+{
+    if (cfg->dv_profile != 7 || !cfg->rpu_present_flag || !cfg->bl_present_flag ||
+        !cfg->el_present_flag || cfg->dv_bl_signal_compatibility_id != 6) {
+        av_log(bsf, AV_LOG_ERROR, "Expected profile 7 HDR10 BL + RPU + EL configuration.\n");
+        return AVERROR(EINVAL);
+    }
+    cfg->dv_profile = 8;
+    cfg->dv_bl_signal_compatibility_id = 1;
+    cfg->el_present_flag = 0;
+    cfg->dv_md_compression = AV_DOVI_COMPRESSION_NONE;
+    return 0;
+}
+
+static int update_fragment(AVBSFContext *bsf, AVPacket *pkt, CodedBitstreamFragment *au)
+{
+    int ret;
+    for (int i = 0; i < au->nb_units; i++) {
+        CodedBitstreamUnit *nal = &au->units[i];
+        if (nal->type == HEVC_NAL_UNSPEC63) {
+            ff_cbs_delete_unit(au, i--);
+        } else if (nal->type == HEVC_NAL_UNSPEC62) {
+            ret = convert_rpu(bsf, nal);
+            if (ret < 0)
+                return ret;
+        }
+    }
+    if (pkt) {
+        size_t size;
+        uint8_t *data = av_packet_get_side_data(pkt, AV_PKT_DATA_DOVI_CONF, &size);
+        if (data) {
+            if (size < sizeof(AVDOVIDecoderConfigurationRecord))
+                return AVERROR_INVALIDDATA;
+            return update_config(bsf, (AVDOVIDecoderConfigurationRecord *)data);
+        }
+    }
+    return 0;
+}
+
+static const CBSBSFType dovi_profile_type = {
+    .codec_id = AV_CODEC_ID_HEVC,
+    .fragment_name = "access unit",
+    .unit_name = "NAL unit",
+    .update_fragment = &update_fragment,
+};
+
+static int dovi_profile_init(AVBSFContext *bsf)
+{
+    const AVPacketSideData *sd = av_packet_side_data_get(bsf->par_out->coded_side_data,
+                                      bsf->par_out->nb_coded_side_data, AV_PKT_DATA_DOVI_CONF);
+    int ret;
+    if (!sd || sd->size < sizeof(AVDOVIDecoderConfigurationRecord)) {
+        av_log(bsf, AV_LOG_ERROR, "Missing Dolby Vision configuration; refusing to invent it.\n");
+        return AVERROR(EINVAL);
+    }
+    ret = update_config(bsf, (AVDOVIDecoderConfigurationRecord *)sd->data);
+    if (ret < 0)
+        return ret;
+    return ff_cbs_bsf_generic_init(bsf, &dovi_profile_type);
+}
+
+static int dovi_profile_filter(AVBSFContext *bsf, AVPacket *pkt)
+{
+    DoviProfileContext *s = bsf->priv_data;
+    int ret = ff_cbs_bsf_generic_filter(bsf, pkt);
+    if (ret == AVERROR_EOF && !s->seen_rpu) {
+        av_log(bsf, AV_LOG_ERROR, "No valid profile 7 RPU observed.\n");
+        return AVERROR_INVALIDDATA;
+    }
+    return ret;
+}
+
+static void dovi_profile_flush(AVBSFContext *bsf)
+{
+    DoviProfileContext *s = bsf->priv_data;
+    s->seen_rpu = 0;
+}
+
+#define OFFSET(x) offsetof(DoviProfileContext, x)
+#define FLAGS (AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_BSF_PARAM)
+static const AVOption dovi_profile_options[] = {
+    { "mode", "libdovi profile 7 to 8.1 conversion; discards enhancement layer", OFFSET(mode), AV_OPT_TYPE_INT, {.i64 = 2}, 2, 2, FLAGS },
+    { NULL }
+};
+static const AVClass dovi_profile_class = {
+    .class_name = "dovi_profile_bsf",
+    .item_name = av_default_item_name,
+    .option = dovi_profile_options,
+    .version = LIBAVUTIL_VERSION_INT,
+};
+static const enum AVCodecID dovi_profile_codec_ids[] = { AV_CODEC_ID_HEVC, AV_CODEC_ID_NONE };
+const FFBitStreamFilter ff_dovi_profile_bsf = {
+    .p.name = "dovi_profile",
+    .p.codec_ids = dovi_profile_codec_ids,
+    .p.priv_class = &dovi_profile_class,
+    .priv_data_size = sizeof(DoviProfileContext),
+    .init = &dovi_profile_init,
+    .close = &ff_cbs_bsf_generic_close,
+    .filter = &dovi_profile_filter,
+    .flush = &dovi_profile_flush,
+};
