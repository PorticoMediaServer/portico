<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>tv.getportico.server.service</string>
 <key>ProgramArguments</key><array><string>/Applications/Portico Media Server.app/Contents/Resources/server/portico-server</string></array>
 <key>EnvironmentVariables</key><dict>
  <key>PORTICO_BIND</key><string>[::]:32500</string>
  <key>PORTICO_WEB_DIR</key><string>/Applications/Portico Media Server.app/Contents/Resources/server/web</string>
  <key>PORTICO_LOG_STDERR</key><string>off</string>
 </dict>
 <key>RunAtLoad</key><true/>
 <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
 <key>ThrottleInterval</key><integer>5</integer>
 <key>ExitTimeOut</key><integer>45</integer>
 <key>StandardOutPath</key><string>/dev/null</string>
 <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
