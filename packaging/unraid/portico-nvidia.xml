<?xml version="1.0"?>
<Container version="2">
  <Name>Portico-NVIDIA</Name><Repository>ghcr.io/porticomediaserver/portico-server:latest</Repository>
  <Registry>https://ghcr.io/porticomediaserver/portico-server</Registry><Network>bridge</Network><Privileged>false</Privileged>
  <Support>https://github.com/PorticoMediaServer/portico-server/issues</Support><Project>https://getportico.tv</Project>
  <Overview>Portico media server. Install the Nvidia Driver plugin and choose the GPU UUID, or keep all GPUs. Store the database on a local cache pool. /mnt/user/appdata is the conventional mapping; prefer /mnt/cache/appdata/portico to avoid the FUSE pool.</Overview>
  <WebUI>http://[IP]:[PORT:32500]/</WebUI><Category>MediaServer:Video</Category>
  <Config Name="Data" Target="/config" Default="/mnt/user/appdata/portico" Mode="rw" Description="Persistent data. Prefer a local cache-pool path such as /mnt/cache/appdata/portico." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/portico</Config>
  <Config Name="Transcode" Target="/transcode" Default="/mnt/cache/appdata/portico-transcode" Mode="rw" Description="Dedicated fast local disk directory for Disk, fallback and spill. Keep this on disk; Memory when available uses a separate bounded tmpfs (Docker /dev/shm by default)." Type="Path" Display="always" Required="false" Mask="false">/mnt/cache/appdata/portico-transcode</Config>
  <Config Name="Media" Target="/media" Default="/mnt/user/media" Mode="ro" Description="Your media library" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media</Config>
  <Config Name="Web" Target="32500" Default="32500" Mode="tcp" Type="Port" Display="always" Required="true" Mask="false">32500</Config>
  <Config Name="PUID" Target="PUID" Default="99" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="0002" Type="Variable" Display="advanced" Required="true" Mask="false">0002</Config>
  <Config Name="TZ" Target="TZ" Default="Etc/UTC" Type="Variable" Display="advanced" Required="true" Mask="false">Etc/UTC</Config>
  <ExtraParams>--runtime=nvidia --gpus=all --env PORTICO_PLATFORM=unraid</ExtraParams>
  <Config Name="NVIDIA_VISIBLE_DEVICES" Target="NVIDIA_VISIBLE_DEVICES" Default="all" Type="Variable" Display="always" Required="true" Mask="false">all</Config>
  <Config Name="NVIDIA_DRIVER_CAPABILITIES" Target="NVIDIA_DRIVER_CAPABILITIES" Default="compute,video,utility" Type="Variable" Display="advanced" Required="true" Mask="false">compute,video,utility</Config>
</Container>
