---
const { src, alt, glow = 'blue' } = Astro.props as { src: string; alt: string; glow?: 'blue' | 'amber' | 'violet' };
---

<figure class={`tv-frame glow-${glow}`}>
  <div class="tv-bezel">
    <img src={src} alt={alt} width="1280" height="720" loading="eager" decoding="async" />
  </div>
  <div class="tv-stand" aria-hidden="true"><span></span><span></span></div>
</figure>
