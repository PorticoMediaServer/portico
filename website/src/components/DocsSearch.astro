<dialog class="docs-search-dialog" aria-label="Search the documentation" data-docs-search>
  <form method="dialog" role="search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16 16 5 5" /></svg>
    <label class="sr-only" for="docs-search-input">Search the documentation</label>
    <input id="docs-search-input" type="search" autocomplete="off" spellcheck="false" placeholder="Search guides, settings and error messages" data-docs-search-input aria-controls="docs-search-results" />
    <button type="submit" value="close">Esc</button>
  </form>
  <ul id="docs-search-results" class="docs-search-results" role="listbox" aria-label="Search results" data-docs-search-results></ul>
</dialog>
<script is:inline defer src="/scripts/docs-search.js"></script>
