---
/* The opening shot: Portico on a TV, a laptop and a phone, lit as one group.
   The TV and phone images are placeholders until real captures replace them. */
---

<div class="devices">
  <div class="devices-light" aria-hidden="true"></div>
  <figure class="device device-tv">
    <div class="device-tv-body">
      <img src="/media/portico-tv-home.jpg" alt="Portico on a TV: Home, with The Last of Us first in Continue Watching" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    </div>
  </figure>
  <figure class="device device-laptop">
    <div class="device-laptop-lid">
      <img src="/media/portico-home.png" alt="Portico Web on a laptop: Home, with Fargo featured in Continue Watching" width="1280" height="720" loading="eager" decoding="async" />
    </div>
    <div class="device-laptop-base" aria-hidden="true"></div>
  </figure>
  <figure class="device device-phone">
    <div class="device-phone-body">
      <img src="/media/portico-phone-home.jpg" alt="Portico on a phone: Home, with Spirited Away featured" width="746" height="1612" loading="eager" decoding="async" />
    </div>
  </figure>
</div>
