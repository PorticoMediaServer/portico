---
import { getCollection } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { docCategories } from '@/data/docs';

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<DocsLayout title="Documentation" description="Install Portico Server, organize your library, connect every screen, and keep it all running." wide>
  <div class="docs-landing">
    <header class="docs-landing-head">
      <h1>Portico documentation</h1>
      <p>Everything from the first install to backups and troubleshooting. Pick the path that fits, or press <kbd>/</kbd> to search every article.</p>
    </header>
    <div class="docs-paths">
      <a href="/docs/start/quick-start/">
        <small>Run a server</small>
        <strong>Quick start</strong>
        <span>Install Portico Server, create the owner, add a library and test playback.</span>
      </a>
      <a href="/docs/clients/connect-a-client/">
        <small>Join a server</small>
        <strong>Connect an app</strong>
        <span>Someone shared their server with you? Sign in and start watching.</span>
      </a>
      <a href="/developers/api/">
        <small>Build on Portico</small>
        <strong>Integrations</strong>
        <span>Connect a tool or build a script with a short task guide.</span>
      </a>
    </div>
    <div class="docs-directory">
      {docCategories.map((category) => {
        const articles = entries.filter((entry) => entry.data.category === category.id);
        return (
          <section>
            <h2><a href={`/docs/${category.id}/`}>{category.title}</a></h2>
            <p>{category.description}</p>
            <ul>
              {articles.map((article) => (
                <li><a href={`/docs/${article.id}/`}>{article.data.title}</a></li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </div>
</DocsLayout>
