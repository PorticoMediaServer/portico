---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TvFrame from '@/components/TvFrame.astro';
import BrowserFrame from '@/components/BrowserFrame.astro';

const features = [
  {
    title: 'Libraries for everything you keep',
    body: 'Separate libraries for movies, TV, anime, music and audiobooks, with live channels and recordings in Live TV and DVR. Portico adds artwork and details without touching the original files.'
  },
  {
    title: 'An account for everyone',
    body: 'Each person signs in with their own account, and each profile keeps its own progress, My List, history and preferences. The server owner decides which libraries and actions each account can use.'
  },
  {
    title: 'Playback that fits the device',
    body: 'Portico plays the original file whenever it can. When a device, audio track, subtitle or connection needs something else, the server remuxes it into a compatible container or transcodes what it has to.'
  },
  {
    title: 'Live TV and DVR',
    body: 'Bring in compatible channels and guide data, watch live, schedule recordings and resolve conflicts, all on the same server.'
  },
  {
    title: 'Direct remote connections',
    body: 'A Portico Account helps your apps find and verify your server. Media then streams directly from your server to your app, never through Portico Services.'
  },
  {
    title: 'Server management built in',
    body: 'Libraries, people, playback, remote access, Live TV, scheduled work, backups, diagnostics and server health, all managed from Settings → Server in Portico Web.'
  }
];
---

<BaseLayout title="Features" description="Libraries, playback, personal accounts, remote access, Live TV and DVR, and server management in Portico.">
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Features</span>
      <h1 class="display-1">For the people who watch, and whoever runs the server.</h1>
      <p class="lede">Viewers get their own home screen, their libraries and a player. Owners get the server controls, and viewers never see them. Everything on this page is free.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/download/">Get Portico</a>
        <a class="button button-ghost" href="/docs/">Read the docs</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container feature-rows">
      <div class="feature-row">
        <div class="feature-copy">
          <h2 class="display-3">Your progress and your lists follow you between devices.</h2>
          <p class="lede">Browse, search, save and resume with the same profile wherever you use Portico. Start on the TV and finish on your phone, on the same server.</p>
          <ul class="check-list">
            <li>Continue Watching follows you between screens</li>
            <li>My List, history and ratings stay with your profile</li>
            <li>Every app signs in to the same server, so everything stays in one place</li>
          </ul>
        </div>
        <TvFrame src="/media/portico-home.png" alt="Portico's Home screen with Continue Watching" glow="blue" />
      </div>
      <div class="feature-row">
        <div class="feature-copy">
          <h2 class="display-3">Posters, cast and episodes, filled in for you.</h2>
          <p class="lede">Portico reads your folders and fills in backdrops, cast and the full season and episode list for each title. If a title is matched wrong, you can pick the right one.</p>
          <a class="text-link" href="/docs/media/fix-a-match/">How to fix a match <span aria-hidden="true">→</span></a>
        </div>
        <BrowserFrame src="/media/portico-detail.png" alt="Portico's show page for Fargo" address="web.getportico.tv" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="display-2">What's in Portico Server.</h2>
      <div class="feature-grid">
        {features.map((feature, index) => (
          <article>
            <span class="feature-index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="features-cta">
    <div class="final-ambient" aria-hidden="true"></div>
    <div class="container">
      <h2 id="features-cta" class="display-1">Start your Portico server.</h2>
      <div class="hero-actions">
        <a class="button button-primary" href="/download/">Get Portico</a>
        <a class="button button-ghost" href="/docs/start/quick-start/">Read the quick start</a>
      </div>
    </div>
  </section>
</BaseLayout>
