---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Devices from '@/components/Devices.astro';
import FinalCta from '@/components/FinalCta.astro';
import PlatformIcon from '@/components/PlatformIcon.astro';
import { serverPlatforms, watchPlatforms } from '@/data/platforms';

const included = [
  { title: 'Remote access, set up for you', body: 'Sign in with a Portico Account and Portico handles the connection. In the future, Portico will offer a paid relay service for those who need it.', icon: '<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />' },
  { title: 'Downloads', body: 'Save titles to your phone or tablet and watch offline.', icon: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14" />' },
  { title: 'Live TV and DVR', body: 'Watch live channels and record from your own tuner.', icon: '<rect x="3" y="6" width="18" height="12" rx="2" /><path d="m9 2 3 4 3-4" /><circle cx="17" cy="15" r="1" />' },
  { title: 'Hardware transcoding', body: "Use the server's graphics hardware when a device needs a converted stream.", icon: '<rect x="6" y="6" width="12" height="12" rx="1.5" /><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />' },
  { title: 'Skip intros and credits', body: 'Portico looks for intros and credits during scans so you can skip past them. The owner approves any uncertain matches.', icon: '<path d="m5 5 9 7-9 7Z" /><path d="M18 5v14" />' },
  { title: 'Synced lyrics', body: 'Lyrics that follow along with the song as it plays.', icon: '<path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" />' },
  { title: 'Every app', body: 'Web, phone, tablet and TV apps, with nothing to buy.', icon: '<rect x="2" y="4" width="14" height="10" rx="1.5" /><path d="M6 18h6M9 14v4" /><rect x="17" y="8" width="5" height="11" rx="1.2" />' },
  { title: 'Accounts for everyone', body: 'No charge per person, however many people you add.', icon: '<circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6" />' }
];

const faqs = [
  {
    q: "What hardware does Portico need?",
    a: "A Windows, macOS or Linux computer (or anything that runs Docker) that can reach your media files and stays on while people are watching. You'll also want a dependable home network, and a Portico app or web browser on each screen you watch on."
  },
  {
    q: "What does Portico cost?",
    a: "Nothing. The server, every app and every feature Portico has today are free, with no subscription and no ads, and they'll stay free. Later on, we plan to offer one optional paid add-on: a relay for servers that can't accept direct connections, designed so we can't see what you watch. Portico is licensed under the GPL, version 3 or later."
  },
  {
    q: "Do I need a Portico Account?",
    a: "No. You can create a server owner that exists only on your server, and local accounts aren't reliant on connections to our servers. A Portico Account is optional. It gives you one sign-in across Portico apps, simple invitations, and a secure connection to your server that Portico sets up for you."
  },
  {
    q: "Can I share my server with family and friends?",
    a: "Yes. Give each person their own account, at no extra cost. Each person's profile keeps its own progress, My List, history and ratings, so you can stop on one screen and finish on another. You choose which libraries each person can see."
  }
];
---

<BaseLayout title="Portico" description="Portico is a free media server that brings your movies, shows, music and more to every screen, with audiobooks and eBooks built in.">
  <section class="opening" aria-labelledby="hero-title">
    <div class="container opening-copy">
      <h1 id="hero-title" class="type-mega"><span class="line">Stream your media</span> <span class="line">anywhere.</span></h1>
      <p class="opening-lede">Portico is a <strong>free</strong> media server that brings your movies, shows, music and more to every screen.</p>
      <div class="actions actions-center">
        <a class="button button-primary" href="/download/">Get Portico</a>
        <a class="button button-ghost" href="#features">See features</a>
      </div>
    </div>
    <div class="opening-stage">
      <Devices />
    </div>
  </section>

  <section class="band unlock" aria-labelledby="free-title">
    <div class="container unlock-grid" id="features">
      <div class="unlock-head">
        <h2 id="free-title" class="type-d1">Nothing to unlock.</h2>
        <p class="lede unlock-lede"><strong>No premium plan here.</strong> Every feature Portico has today is free for everyone and will stay that way, and we'll keep improving Portico for free. We'll only charge for something new that costs us real money to run, like relaying video, and never for a feature you already have.</p>
        <p class="lede unlock-lede"><strong>Open source, so it stays yours.</strong> Portico Server and the Portico apps are open source under the GPL, version 3 or later. Anyone can read, build and run the code, so you can always see how it works, and keep it running your way.</p>
      </div>
      <ul class="unlock-list" role="list">
        {included.map((feature) => (
          <li>
            <span class="glyph"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={feature.icon} /></span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band kinds" aria-labelledby="kinds-title">
    <div class="container">
      <div class="band-split kinds-head">
        <h2 id="kinds-title" class="type-d1">Not just movies.</h2>
        <p class="lede">A true library is more than movies and shows. Portico gives all your media a first-class experience, including music, audiobooks and eBooks – right out of the box.</p>
      </div>

      <ul class="kinds-grid" role="list">
        <li class="kind kind-movies">
          <div class="kind-art" aria-hidden="true">
            <div class="art-posters"><i></i><i></i><i></i></div>
            <span class="art-chip">Collection<small>3 titles on your server</small></span>
          </div>
          <h3>Movies</h3>
          <p>Your films, with collections kept together.</p>
        </li>

        <li class="kind kind-tv">
          <div class="kind-art" aria-hidden="true">
            <div class="art-seasons"><span>Season 1</span><span class="is-on">Season 2</span><span>Season 3</span></div>
            <div class="art-row"><b>Episode 4</b><i style="--progress: 100%"></i></div>
            <div class="art-row"><b>Episode 5</b><i style="--progress: 38%"></i></div>
            <span class="art-pill">Skip intro</span>
          </div>
          <h3>TV shows</h3>
          <p>Pick up the next episode and skip the intros.</p>
        </li>

        <li class="kind kind-anime">
          <div class="kind-art" aria-hidden="true">
            <div class="art-row art-row-dim"><b>Episode 212</b></div>
            <div class="art-row art-row-now"><b>Episode 213</b><i style="--progress: 54%"></i></div>
            <div class="art-row art-row-dim"><b>Episode 214</b></div>
            <span class="art-chip">Absolute numbering</span>
          </div>
          <h3>Anime</h3>
          <p>Long-running series, always in the right order.</p>
        </li>

        <li class="kind kind-music">
          <div class="kind-art" aria-hidden="true">
            <div class="art-lyrics">
              <span>All the windows open</span>
              <span class="is-on">and the evening coming in</span>
              <span>we can stay a little longer</span>
            </div>
            <div class="art-mixes"><span>Ambient mix</span><span>From your listening</span></div>
          </div>
          <h3>Music</h3>
          <p>Albums, personal mixes and lyrics that follow along.</p>
        </li>

        <li class="kind kind-audiobooks">
          <div class="kind-art" aria-hidden="true">
            <div class="art-cover"></div>
            <div class="art-listen">
              <small>Chapter 14 of 32</small>
              <div class="art-scrub"><i style="--progress: 42%"></i></div>
              <div class="art-controls">
                <span class="art-pill">1.25×</span>
                <span class="art-pill"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>Sleep timer</span>
                <span class="art-pill"><svg viewBox="0 0 24 24"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" /></svg>Chapters</span>
              </div>
            </div>
          </div>
          <h3>Audiobooks</h3>
          <p>Chapters, speed control and a sleep timer.</p>
        </li>

        <li class="kind kind-ebooks">
          <div class="kind-art" aria-hidden="true">
            <div class="art-page">
              <span class="art-line"></span><span class="art-line"></span><span class="art-line art-line-mark"></span><span class="art-line"></span><span class="art-line art-line-short"></span>
              <span class="art-gap"></span>
              <span class="art-line"></span><span class="art-line"></span><span class="art-line art-line-short"></span>
            </div>
            <div class="art-display">
              <span class="art-aa">Aa</span>
              <span class="art-swatch art-swatch-light"></span><span class="art-swatch art-swatch-sepia"></span><span class="art-swatch art-swatch-dark is-on"></span>
            </div>
            <div class="art-comic"><i></i><i></i><i></i><i></i></div>
          </div>
          <h3>eBooks</h3>
          <p>Books and comics in a reader you make your own.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="band private" aria-labelledby="access-title">
    <div class="container">
      <div class="band-split">
        <h2 id="access-title" class="type-d1">Truly simple remote access.</h2>
        <p class="lede">Link your server to a free Portico Account and Portico takes care of the networking. Family and friends sign in on their own devices, and your server is there, at home or away.</p>
      </div>
      <ul class="access-grid" role="list">
        <li class="access-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
          <h3>Network setup made easy</h3>
          <p>Portico automatically coordinates secure connections between your server and client devices. Setup takes just a few minutes.</p>
        </li>
        <li class="access-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5.5c0 4.6 3 8 7 9.5 4-1.5 7-4.9 7-9.5V6Z" /><path d="m9 12 2.2 2.2L15.5 10" /></svg>
          <h3>Secure by default</h3>
          <p>Every Portico server gets a free SSL certificate, and comes with enhanced security features that help prevent automated network attacks when using remote access.</p>
        </li>
        <li class="access-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z" /><path d="M14 14h2v2h-2zM18 14h2M14 18h2v2M18 18h2v2h-2" /></svg>
          <h3>Invites made easy</h3>
          <p>Invite family and friends with a simple invite link or QR code. With a Portico Account, they just sign in and enjoy.</p>
        </li>
      </ul>
      <div class="trust">
        <p class="trust-lead">Portico makes it easy to handle sign-in and connections, but we never see your library, file metadata or watch history.</p>
        <ul class="trust-points" role="list">
          <li><strong>Optional by design.</strong> Want even more separation? Portico Services are optional: Portico Server supports local accounts, which aren't reliant on connections to our servers.</li>
          <li><strong>Open source.</strong> Portico is licensed under the GPL, version 3 or later, so anyone can read the code and check what it does.</li>
          <li><strong>Optional relay, coming later.</strong> For servers that can't (or would rather not) use a typical network setup, we plan to offer a paid relay, designed so we can't see what you watch. It's the only paid service planned, and standard remote access, including through Portico Services, will always be free.</li>
        </ul>
        <div class="private-links">
          <a class="text-link" href="/docs/remote/how-portico-connects/">How Portico connects</a>
          <a class="text-link" href="/privacy/">Read the privacy policy</a>
          <a class="text-link" href="https://github.com/PorticoMediaServer/portico">View the source</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band screens" aria-labelledby="screens-title">
    <div class="container">
      <div class="band-split">
        <h2 id="screens-title" class="type-d1">Apps for the screens you already own.</h2>
        <p class="lede">A web app, plus native apps for phones, tablets, TVs and streaming players. The TV apps are made for a remote, and the phone apps for touch.</p>
      </div>
      <div class="device-wall">
        <div class="device-group device-group-watch">
          <h3>Watch on</h3>
          <ul role="list">
            {watchPlatforms.map((platform) => (
              <li><PlatformIcon name={platform.icon} /><span>{platform.name}</span></li>
            ))}
          </ul>
        </div>
        <div class="device-group device-group-server">
          <h3>Run the server on</h3>
          <ul role="list">
            {serverPlatforms.map((platform) => (
              <li><PlatformIcon name={platform.icon} /><span>{platform.name}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <a class="text-link" href="/download/">See all downloads</a>
    </div>
  </section>

  <section class="band setup" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title" class="type-d1 band-title">How setup works.</h2>
      <ol class="steps" role="list">
        <li>
          <span class="step-n" aria-hidden="true">1</span>
          <h3>Install the server</h3>
          <p>On the computer that holds your media, install Portico Server for Windows, macOS or Linux, or run it in Docker.</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">2</span>
          <h3>Add your folders</h3>
          <p>Create a library for each kind of media. Portico scans the files and fills in artwork and details.</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">3</span>
          <h3>Add the people who watch</h3>
          <p>Create an account for each person, then sign in from Portico Web or a Portico app on any screen.</p>
        </li>
      </ol>
      <a class="text-link" href="/docs/start/quick-start/">Read the quick start</a>
    </div>
  </section>

  <section class="band questions" aria-labelledby="faq-title">
    <div class="container questions-grid">
      <div class="questions-head">
        <h2 id="faq-title" class="type-d1">Common questions.</h2>
        <p>Guides for installing Portico, adding media, remote access and backups, plus help when a connection or a file won't play.</p>
        <a class="text-link" href="/docs/">Browse the docs</a>
      </div>
      <div class="questions-list">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}<span class="questions-icon" aria-hidden="true"></span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <FinalCta id="cta-title" secondary={{ label: 'Quick start', href: '/docs/start/quick-start/' }} />
</BaseLayout>
